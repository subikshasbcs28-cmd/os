#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
int main()
{
   pid_t pid;
   pid=fork();
   if(pid<0)
   {
      perror("Fork Failed");
      return 1;
   }
   if(pid==0)
   {
      printf("P1->PID=%d,PPID=%d\n",getpid(),getppid());
   }
   else
   {
      wait(NULL);
      printf("P2->PID=%d\n",getpid());
   }
return 0;
}
